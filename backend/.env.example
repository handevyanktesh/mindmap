# MindMap Backend Environment Configuration
# Copy this file to backend/.env for local backend execution.

# Application Environment: 'development' or 'production'
# In production, startup strictly rejects placeholder, default, or short JWT_SECRET values.
ENVIRONMENT=development

# MongoDB Connection String (Atlas URI or local MongoDB instance)
# Example local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017

# MongoDB database name (default: mindmap_db)
DATABASE_NAME=mindmap_db

# Secret key used for signing JWT tokens
# Development: 'supersecretkey_dev_testing_only' is permitted.
# Production: MUST be an independently generated, cryptographically random string (min 32 chars).
JWT_SECRET=supersecretkey_dev_testing_only

# Algorithm for JWT signing (default: HS256)
JWT_ALGORITHM=HS256

# Expiry duration for JWT tokens in minutes (default: 10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# Allowed CORS Origins (comma-separated list of trusted origins)
# For local development: http://localhost:5173,http://localhost:3000
# For production: Add your custom domain and production Vercel frontend URL, e.g.
# CORS_ORIGINS=https://mindmap.vercel.app,https://yourcustomdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
