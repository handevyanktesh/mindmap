# MindMap Frontend Environment Configuration
# Copy this file to .env or .env.local for local overrides.

# FastAPI HTTP/REST backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# FastAPI WebSocket backend base URL (optional, derived from VITE_API_BASE_URL if omitted)
VITE_WS_BASE_URL=ws://localhost:8000

# WebRTC ICE Servers (optional JSON string for custom STUN/TURN relays)
# Defaults to public Google STUN if omitted
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"mindmap","credential":"turnpassword"}]
